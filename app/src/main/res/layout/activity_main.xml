<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical">

    <!-- Display -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2"
        android:background="@color/surface" android:orientation="vertical" android:padding="16dp" android:gravity="bottom">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnDeg" android:layout_width="wrap_content" android:layout_height="28dp"
                android:text="DEG" android:textSize="10sp" android:background="@color/accent_dim"
                android:textColor="@color/accent" android:paddingStart="8dp" android:paddingEnd="8dp"/>
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            <Button android:id="@+id/btnHistory" android:layout_width="wrap_content" android:layout_height="28dp"
                android:text="History" android:textSize="10sp" android:background="@color/accent_dim"
                android:textColor="@color/accent" android:paddingStart="8dp" android:paddingEnd="8dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvExpression" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_hint" android:textSize="16sp" android:gravity="end"
            android:singleLine="true" android:ellipsize="start" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvResult" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="0" android:textColor="@color/accent" android:textSize="40sp"
            android:textStyle="bold" android:gravity="end" android:singleLine="true" android:ellipsize="start"/>
    </LinearLayout>

    <!-- Scientific row 1 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.7" android:orientation="horizontal">
        <Button android:id="@+id/btnSin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="sin" android:textColor="@color/accent" android:textSize="12sp"/>
        <Button android:id="@+id/btnCos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="cos" android:textColor="@color/accent" android:textSize="12sp"/>
        <Button android:id="@+id/btnTan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="tan" android:textColor="@color/accent" android:textSize="12sp"/>
        <Button android:id="@+id/btnLn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="ln" android:textColor="@color/accent" android:textSize="12sp"/>
        <Button android:id="@+id/btnLog" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="log" android:textColor="@color/accent" android:textSize="12sp"/>
    </LinearLayout>

    <!-- Scientific row 2 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.7" android:orientation="horizontal">
        <Button android:id="@+id/btnAsin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="asin" android:textColor="@color/accent" android:textSize="11sp"/>
        <Button android:id="@+id/btnAcos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="acos" android:textColor="@color/accent" android:textSize="11sp"/>
        <Button android:id="@+id/btnAtan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="atan" android:textColor="@color/accent" android:textSize="11sp"/>
        <Button android:id="@+id/btnSqrt" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="√" android:textColor="@color/accent" android:textSize="16sp"/>
        <Button android:id="@+id/btnSq" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="x²" android:textColor="@color/accent" android:textSize="14sp"/>
    </LinearLayout>

    <!-- Scientific row 3 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.7" android:orientation="horizontal">
        <Button android:id="@+id/btnLog2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="log₂" android:textColor="@color/accent" android:textSize="11sp"/>
        <Button android:id="@+id/btnExp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="eˣ" android:textColor="@color/accent" android:textSize="13sp"/>
        <Button android:id="@+id/btnPow10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="10ˣ" android:textColor="@color/accent" android:textSize="13sp"/>
        <Button android:id="@+id/btnCbrt" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="∛" android:textColor="@color/accent" android:textSize="16sp"/>
        <Button android:id="@+id/btnCube" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="x³" android:textColor="@color/accent" android:textSize="13sp"/>
    </LinearLayout>

    <!-- Scientific row 4 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.7" android:orientation="horizontal">
        <Button android:id="@+id/btnFact" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="x!" android:textColor="@color/accent" android:textSize="13sp"/>
        <Button android:id="@+id/btnInv" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="1/x" android:textColor="@color/accent" android:textSize="12sp"/>
        <Button android:id="@+id/btnAbs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="|x|" android:textColor="@color/accent" android:textSize="13sp"/>
        <Button android:id="@+id/btnPi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="π" android:textColor="@color/accent" android:textSize="16sp"/>
        <Button android:id="@+id/btnE" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sci_bg" android:text="e" android:textColor="@color/accent" android:textSize="14sp"/>
    </LinearLayout>

    <!-- Basic row 1: C, (, ), %, ÷ -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.9" android:orientation="horizontal">
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/op_bg" android:text="C" android:textColor="#F44336" android:textSize="18sp" android:textStyle="bold"/>
        <Button android:id="@+id/btnOpenParen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/op_bg" android:text="(" android:textColor="@color/op_color" android:textSize="18sp"/>
        <Button android:id="@+id/btnCloseParen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/op_bg" android:text=")" android:textColor="@color/op_color" android:textSize="18sp"/>
        <Button android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/op_bg" android:text="%" android:textColor="@color/op_color" android:textSize="18sp"/>
        <Button android:id="@+id/btnDiv" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/op_bg" android:text="÷" android:textColor="@color/op_color" android:textSize="22sp"/>
    </LinearLayout>

    <!-- Basic row 2: 7, 8, 9, × -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.9" android:orientation="horizontal">
        <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/num_bg" android:text="7" android:textColor="@color/text_primary" android:textSize="20sp"/>
        <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/num_bg" android:text="8" android:textColor="@color/text_primary" android:textSize="20sp"/>
        <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/num_bg" android:text="9" android:textColor="@color/text_primary" android:textSize="20sp"/>
        <Button android:id="@+id/btnMul" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/op_bg" android:text="×" android:textColor="@color/op_color" android:textSize="22sp"/>
        <Button android:id="@+id/btnPow" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/op_bg" android:text="^" android:textColor="@color/op_color" android:textSize="20sp"/>
    </LinearLayout>

    <!-- Basic row 3: 4, 5, 6, - -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.9" android:orientation="horizontal">
        <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/num_bg" android:text="4" android:textColor="@color/text_primary" android:textSize="20sp"/>
        <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/num_bg" android:text="5" android:textColor="@color/text_primary" android:textSize="20sp"/>
        <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/num_bg" android:text="6" android:textColor="@color/text_primary" android:textSize="20sp"/>
        <Button android:id="@+id/btnMinus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/op_bg" android:text="-" android:textColor="@color/op_color" android:textSize="24sp"/>
        <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/op_bg" android:text="⌫" android:textColor="@color/op_color" android:textSize="20sp"/>
    </LinearLayout>

    <!-- Basic row 4: 1, 2, 3, + -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.9" android:orientation="horizontal">
        <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/num_bg" android:text="1" android:textColor="@color/text_primary" android:textSize="20sp"/>
        <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/num_bg" android:text="2" android:textColor="@color/text_primary" android:textSize="20sp"/>
        <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/num_bg" android:text="3" android:textColor="@color/text_primary" android:textSize="20sp"/>
        <Button android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/op_bg" android:text="+" android:textColor="@color/op_color" android:textSize="22sp"/>
        <Button android:id="@+id/btnEquals" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/primary" android:text="=" android:textColor="#000000" android:textSize="24sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Basic row 5: 0, ., -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.9" android:orientation="horizontal">
        <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:background="@color/num_bg" android:text="0" android:textColor="@color/text_primary" android:textSize="20sp"/>
        <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/num_bg" android:text="." android:textColor="@color/text_primary" android:textSize="20sp"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
